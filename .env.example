# Copy this file to .env and fill in the values from your Firebase project's
# web app config (Firebase Console → Project Settings → Your apps → Web app).
# These values are NOT secret — Firebase client config is safe to expose in a
# browser bundle. Real protection comes from Firebase Authentication and
# Firestore/Storage Security Rules, not from hiding this config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The only account allowed into /admin. Must match a user created directly
# in the Firebase Console (Authentication → Users) — never store the admin
# password in this project.
VITE_ADMIN_EMAIL=Khayaaljewels@gmail.com

# Customer authentication now runs through the separate backend in /server
# (Google OAuth via Passport.js + PostgreSQL), not Firebase. This is that
# backend's URL — see server/.env.example for its own setup.
VITE_API_URL=http://localhost:4000
